import random
#ENTER A LENGTH
LENGTH=int(input("Enter a length: "))
capital_alphabet="QWERTYUIOPASDFGHJKLZXCVBNM"
small_alphabet="qwertyuiopasdfghjklzxcvbnm"
digits="1234567890"
special_symbols="@!#$%^&*(){}[]<>,.?/;:'"
emoji="😭😊🥰😂✨✅❤😍🤣❤😍🤣💀💀"
combine_all=small_alphabet+capital_alphabet+digits+special_symbols+emoji
password=''.join(random.sample(combine_all,LENGTH))
if(LENGTH >=8):
    print("password:",password)
else:
    print("password length should be 8 or greater than 8")

